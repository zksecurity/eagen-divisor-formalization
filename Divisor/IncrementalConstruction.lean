private theorem cross_case_mul_a_b_secondDerivative_vanish_when_m_eq_three
    {D₁ D₂ : CoordRingElt E.q}
    (h₁ : ¬ (D₁.a = 0 ∧ D₁.b = 0)) (h₂ : ¬ (D₂.a = 0 ∧ D₂.b = 0))
    {P : ZMod E.q × ZMod E.q} (hP : P ∈ E.points) (hY : P.2 ≠ 0)
