theorem eagenBuild_length4_div_at_P₁
    (P₀ P₁ P₂ P₃ : ZMod E.q × ZMod E.q)
    (hP₀ : P₀ ∈ E.points) (hP₁ : P₁ ∈ E.points)
    (hP₂ : P₂ ∈ E.points) (hP₃ : P₃ ∈ E.points)
